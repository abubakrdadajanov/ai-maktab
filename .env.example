# AI Maktab — Muhit o'zgaruvchilari namunasi (.env.example)

# 1. Server sozlamalari
PORT=3000
NODE_ENV=development

# 2. Xavfsizlik va Sessiya
# Kamida 32 ta belgidan iborat tasodifiy maxfiy kalit
JWT_SECRET=ai-maktab-super-secure-production-jwt-key-2026-uz
COOKIE_SECURE=false

# 3. Ma'lumotlar bazasi (PostgreSQL)
# Agar tashqi PostgreSQL serveringiz bo'lsa:
# DATABASE_URL=postgresql://postgres:parol@localhost:5432/aimaktab_db
# Agar DATABASE_URL ko'rsatilmasa yoki ulanmasa, dastur avtomatik tarzda
# o'rnatilgan (embedded) PGlite PostgreSQL dvigatelidan foydalanadi (data/aimaktab_pg papkasida).
DATABASE_URL=

# 4. Sun'iy Intellekt (AI Chat & Prompt Lab Evaluation)
# OpenAI, OpenRouter, Groq yoki ixtiyoriy OpenAI-mos API kaliti:
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 5. Dastlabki Administrator hisobi (db/seed.js uchun)
ADMIN_NAME=AI Maktab Bosh Administrator
ADMIN_EMAIL=admin@aimaktab.uz
ADMIN_PASSWORD=AdminPassword2026!
